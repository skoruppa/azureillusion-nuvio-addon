# Read by `wrangler dev` (.env) and scripts/smoke.sh. In production set SIMKL_CLIENT_ID with `wrangler secret put`.
# Enables IMDb (tt...) support. Without it only kitsu:/mal:/anilist: IDs are handled.
SIMKL_CLIENT_ID=
# Base URL of the fonts service (fonts/, deployed to Vercel). Locally: `npm run dev` in fonts/ -> http://localhost:3001
# Without it /{key}/fonts/ behaves like /{key}/ (plain files).
FONTS_BASE_URL=http://localhost:3001
# Only used by scripts/smoke.sh; the addon itself takes user keys from the URL.
AZUREILLUSION_API_KEY=
